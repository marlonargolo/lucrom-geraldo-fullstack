# URL base da API NestJS (apps/api). Em docker-compose local: http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Mesmo valor de API_TOKEN configurado em apps/api/.env (ApiTokenGuard).
# SEM prefixo NEXT_PUBLIC_ — DE PROPÓSITO (correção pós-auditoria, Isolamento
# de Tenants): esse token é um segredo servidor-a-servidor. Com NEXT_PUBLIC_,
# o Next.js injeta o valor no bundle do NAVEGADOR, e QUALQUER visitante do
# site consegue lê-lo (view-source/devtools) e chamar o backend direto, sem
# login nenhum. Fica disponível só em Route Handlers/Server Components/
# Server Actions — exatamente onde precisa estar (ver app/api/backend/[...path]/route.ts
# e lib/production/backend-proxy.ts).
API_TOKEN=dev-local-token

# Tenant padrão deste ambiente. Não é usado no cadastro — POST
# /api/v1/auth/register cria um Tenant novo automaticamente pra cada MEI
# (ver AuthService.register em apps/api). Esta variável só serve pra
# telas/fluxos legados que ainda assumem um tenant fixo (se houver); pode
# ficar vazia em produção.
NEXT_PUBLIC_TENANT_ID=00000000-0000-0000-0000-000000000001

# Mostra a aba "Arquitetura" (diagrama interno do sistema) no menu do
# Estúdio (ver components/studio/studio-shell.tsx) — só pra demos/uso
# interno da equipe. Deixar de fora (ou "false") em produção: o cliente
# final não deve ver estrutura interna do produto.
NEXT_PUBLIC_SHOW_INTERNAL_VIEWS=false

# ─── Rate limiting distribuído — /api/ai/generate-ad ─────────────────────────
# Mesma instância Redis usada pelo backend (apps/api) para a fila BullMQ —
# ver apps/api/.env.example. Sem REDIS_HOST configurado, o rate limit cai
# pra um Map em memória por processo (ok pra uma única instância; em
# produção com múltiplas réplicas, configure isto).
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ─── lib/ai-services.ts — provedores de IA de baixo custo (Fase 2) ───────────
# IMPORTANTE: NÃO usar prefixo NEXT_PUBLIC_ nestas — de propósito. Sem o
# prefixo, o Next.js nunca injeta essas chaves no bundle do navegador; elas só
# ficam disponíveis em código server-side (Route Handler, Server Action,
# Server Component). Sem nenhuma delas configurada, lib/ai-services.ts cai
# automaticamente pro pipeline grátis (Pollinations) + fallback local — nada
# quebra. Veja o cabeçalho de lib/ai-services.ts para mais detalhes.

# Texto — anúncio do MEI (hook/body/cta/visual/narração). Ordem de tentativa:
# Gemini Flash -> DeepSeek -> Pollinations (grátis) -> local.
# GEMINI_API_KEY=sua_chave_gemini_aqui
# GEMINI_MODEL=gemini-3.5-flash-lite
# DEEPSEEK_API_KEY=sua_chave_deepseek_aqui
# DEEPSEEK_MODEL=deepseek-v4-flash

# Imagem — background das cenas via FLUX.1 (fal.ai). Sem chave, cai pro FLUX
# grátis via Pollinations (já usado em lib/ai/free-ai.ts).
# FAL_API_KEY=sua_chave_fal_aqui
# FAL_IMAGE_MODEL=fal-ai/flux/schnell

# Narração — Edge-TTS (Microsoft Edge "Ler em voz alta") é grátis e não
# precisa de chave, mas só roda server-side. Defina como "true" só se quiser
# desativá-lo e usar direto o TTS grátis via Pollinations (lib/ai/tts.ts).
# DISABLE_EDGE_TTS=false

# ─── Autenticação — /api/ai/*, /api/media/*, /api/instagram/* (SaaS gate) ────
# MESMO valor de JWT_SECRET configurado em apps/api/.env — os dois processos
# validam o token com o segredo simétrico HS256 compartilhado (ver
# lib/auth/verify-jwt.ts). Sem isso (ou com valor diferente do backend),
# TODA chamada às rotas acima retorna 401, mesmo pra usuários logados.
# JWT_SECRET=troque_por_um_segredo_forte_gerado_com_openssl

# ─── app/api/instagram/publish/route.ts — publicação de Reels (Fase 4) ──────
# Conta do Instagram precisa ser Business/Creator conectada a uma Página do
# Facebook, com token de longa duração com a permissão
# 'instagram_content_publish' aprovada pela Meta.
# INSTAGRAM_BUSINESS_ACCOUNT_ID=17841400000000000
# INSTAGRAM_ACCESS_TOKEN=seu_token_de_acesso_aqui
# META_GRAPH_API_VERSION=v21.0
# INSTAGRAM_POLL_INTERVAL_MS=4000
# INSTAGRAM_POLL_MAX_ATTEMPTS=45

# ─── Billing & Checkout (Mercado Pago) ───────────────────────────────────────
# Chave privada da sua conta Mercado Pago (Credenciais de Produção ou Teste).
# MERCADOPAGO_ACCESS_TOKEN=seu_access_token_aqui
# Chave secreta configurada em Notificações > Webhooks no painel do
# Mercado Pago — usada pra verificar a assinatura de cada notificação.
# MERCADOPAGO_WEBHOOK_SECRET=seu_webhook_secret_aqui
# Preço do plano PRO em centavos (default 4990 = R$ 49,90).
# BILLING_PRO_PLAN_PRICE_CENTS=4990
# Precisa da mesma URL pública usada em lib/storage/temp-video-storage.ts —
# o Mercado Pago chama esse domínio de volta pra notificar pagamentos.
# PUBLIC_SITE_URL=

# ─── lib/storage/temp-video-storage.ts — storage temporária p/ publicação ───
# Mesmas variáveis S3/MinIO do backend (apps/api/.env.example) — se já
# configuradas lá, o upload deste app usa o mesmo bucket automaticamente.
# Sem S3_ACCESS_KEY, cai pro fallback em disco local (/tmp), servido por
# app/api/media/[...key]/route.ts com URL assinada.
# S3_ENDPOINT=localhost
# S3_PORT=9000
# S3_USE_SSL=false
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=lucrom-studio-media

# Só usadas no fallback local (sem S3 configurado):
# URL pública deste próprio app — obrigatória p/ a Meta conseguir buscar o
# vídeo de volta. Ex.: https://studio.seudominio.com.br
# PUBLIC_SITE_URL=
# Segredo pra assinar as URLs locais (HMAC). Gere um valor aleatório forte
# em produção — sem isso, um segredo de desenvolvimento inseguro é usado.
# MEDIA_SIGNING_SECRET=
