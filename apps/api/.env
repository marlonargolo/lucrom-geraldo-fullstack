# =============================================================================
# LUCROM Studio AI — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais no repositório.
# =============================================================================

# ─── Autenticação da API ──────────────────────────────────────────────────────
# Token estático Bearer usado pelo ApiTokenGuard em todos os endpoints protegidos.
# Gere com: openssl rand -hex 32
API_TOKEN=seu_api_token_aqui

# ─── Serviços de IA e Transcrição ────────────────────────────────────────────

# AssemblyAI (alternativa ao WhisperX para transcrição — não usado diretamente,
# mas documentado para referência de integração futura)
# ASSEMBLYAI_API_KEY=sua_chave_assemblyai

# Replicate — obrigatório para as etapas generativas do pipeline M8:
#   Etapa 1: WhisperX (transcrição word-level) + DeepFilterNet (isolamento vocal)
#   Etapa 2: Robust Video Matting — RVM (recorte de fundo)
#   Etapa 3: Flux-schnell (geração de fundo por nicho)
# Obtenha em: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=seu_token_replicate

# ElevenLabs — alternativa ao DeepFilterNet para isolamento de áudio
# (não usado diretamente na implementação atual — integração futura)
# ELEVENLABS_API_KEY=sua_chave_elevenlabs

# Fal.ai — alternativa ao Flux/Replicate para geração de fundos por nicho
# (não usado diretamente na implementação atual — integração futura)
# FAL_KEY=sua_chave_fal_ai

# ─── Modelos Generativos (sobrescrevem os defaults de configuration.ts) ───────

# Robust Video Matting — Etapa 2
# MODEL_ROBUST_VIDEO_MATTING=arielreplicate/robust_video_matting

# WhisperX — Etapa 1 (transcrição word-level)
# MODEL_WHISPERX=victor-upmeet/whisperx:84d2ad2d6194fe98efb918a5bc05c61ebef18cce5d77c7a7ce5b1b6b7cfd7c7f

# DeepFilterNet — Etapa 1 (isolamento vocal)
# MODEL_DEEPFILTERNET=adirik/deepfilternet

# Flux — Etapa 3 (geração de fundo por nicho)
# MODEL_FLUX=black-forest-labs/flux-schnell

# ─── Infraestrutura do Backend ────────────────────────────────────────────────

# Redis — necessário para a fila BullMQ (jobs:render:high_priority / jobs:render:standard)
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL — string de conexão completa (prioridade sobre DB_HOST/PORT/USER/PASSWORD/NAME)
#DATABASE_URL=postgresql://lucrom:lucrom@localhost:5432/lucrom_studio_ai

# PostgreSQL — parâmetros individuais (usados quando DATABASE_URL não está definido)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=lucrom
# DB_PASSWORD=lucrom
# DB_NAME=lucrom_studio_ai

# ─── Storage S3 / MinIO ───────────────────────────────────────────────────────
# Sem S3_ACCESS_KEY configurado, o sistema usa /tmp/lucrom-storage como fallback
# (adequado para desenvolvimento local, não para produção).
# S3_ENDPOINT=localhost
# S3_PORT=9000
# S3_USE_SSL=false
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=lucrom-studio-media
# S3_PUBLIC_URL=http://localhost:9000

# ─── LLM (ScriptGeneratorService + VoiceCommandService) ───────────────────────
# Chave de API do provedor LLM. Por padrão usa a Anthropic Messages API.
# LLM — DeepSeek Platform API (roteiro/copy + comandos de voz + digital twin)
LLM_API_KEY=sua_chave_deepseek_aqui
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/chat/completions
# LLM_CONTEXT_CACHING=true

# ─── Puppeteer (GraphicComposerService) ───────────────────────────────────────
# Só necessário se você quiser usar um Chromium já instalado no ambiente em vez
# do Chromium que o Puppeteer baixa/empacota automaticamente.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ─── JWT (AuthModule — cadastro/login real) ───────────────────────────────────
# Agora OBRIGATÓRIO: assina o JWT de sessão emitido em /api/v1/auth/register e
# /api/v1/auth/login (AuthService), consumido pelo JwtAuthGuard (BrandModule,
# UsageModule) e, opcionalmente, pelo AuthAuditMiddleware via X-Actor-Token
# pra enriquecer o campo "actor" da trilha de auditoria. Não substitui o
# API_TOKEN acima, que continua protegendo as rotas serviço-a-serviço.
# Gere com: openssl rand -hex 32
JWT_SECRET=troque_por_um_segredo_forte
# JWT_EXPIRES_IN=7d

# ─── Orquestração de IA — SOMENTE PROVEDORES CHINESES (Kling primário + MiniMax fallback) ─
# AJUSTE (pedido do cliente: "usando somente a API chinesa"): FAL_API_KEY e o
# uso do REPLICATE_API_TOKEN para vídeo (acima, na seção Replicate, ele
# CONTINUA necessário só para RVM/WhisperX/Flux) foram substituídos pelas
# credenciais diretas da Kling (Kuaishou) e da MiniMax (Hailuo).

# Kling AI — painel de desenvolvedor: https://kling.ai/dev
# Autenticação é JWT (não é uma chave estática): o par abaixo assina um
# token de curta duração a cada requisição (ver kling-client.service.ts).
KLING_ACCESS_KEY_ID=seu_access_key_id_kling
KLING_ACCESS_KEY_SECRET=seu_access_key_secret_kling
# KLING_BASE_URL=https://api-singapore.klingai.com
# KLING_MODEL=kling-v1

# MiniMax (Hailuo) — painel: https://platform.minimax.io
MINIMAX_API_KEY=sua_chave_minimax_aqui
# MINIMAX_BASE_URL=https://api.minimax.io
# MINIMAX_MODEL=MiniMax-Hailuo-2.3

# AI_CIRCUIT_BREAKER_THRESHOLD=3
# AI_CIRCUIT_BREAKER_COOLDOWN_MS=60000

# ─── Avatar Real + Voz Clonada + Lip-Sync (engines/avatar/*) ──────────────
# NENHUMA variável nova aqui: o módulo de avatar reaproveita 100% das
# credenciais KLING_* (lip-sync, via KlingClientService.identifyFace /
# submitLipSync) e MINIMAX_* (clonagem de voz + TTS, via
# MinimaxClientService.cloneVoice / synthesizeSpeech) já configuradas acima.
# Decisão registrada em conversa com o cliente: descartado trazer HeyGen
# (avatar) + ElevenLabs (voz) como fornecedores novos — zero superfície de
# segurança nova, zero assinatura nova, mesmos dois provedores chineses de
# sempre.
# URL pública desta API — usada para montar a URL de callback dos webhooks
# (Kling/MiniMax precisam alcançar esta URL pela internet; em dev local,
# use um túnel como ngrok e aponte pra cá).
PUBLIC_WEBHOOK_BASE_URL=http://localhost:3000

# NOTA (docker-compose): ao rodar via `docker compose up`, DB_HOST/REDIS_HOST
# são sobrescritos automaticamente para os nomes dos serviços (postgres/redis)
# — não defina DATABASE_URL neste .env se for usar o docker-compose.yml da raiz.

# ─── Configuração do Servidor ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Worker ───────────────────────────────────────────────────────────────────
# Número de jobs processados em paralelo pelo worker BullMQ
WORKER_CONCURRENCY=2
